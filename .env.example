# TradingAgents 环境变量配置示例
# 复制此文件为 .env 并填入您的实际配置值

# =============================================================================
# 项目路径配置
# =============================================================================

# 结果输出目录
RESULTS_DIR=./results

# 数据目录 (用于离线数据)
DATA_DIR=./data

# =============================================================================
# LLM 提供商配置
# =============================================================================

# LLM 提供商 (支持: openai, anthropic, google, ollama, openrouter, deepseek)
LLM_PROVIDER=openai
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=sk-1234
# 深度思考模型 (用于复杂分析)
LLM_DEEP_MODEL=deepseek-reasoner
# 快速思考模型 (用于简单任务)
LLM_QUICK_MODEL=deepseek-chat

# =============================================================================
# 嵌入模型配置
# =============================================================================
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_BACKEND_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-1234

# =============================================================================
# 外部服务 API 配置
# =============================================================================

# Tavily 搜索 API 密钥 (用于网络搜索)
TAVILY_API_KEY=tvly-dev-1234

# Finnhub API 密钥 (用于股票数据)
FINNHUB_API_KEY=

# Reddit API 配置 (用于社交媒体分析)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# =============================================================================
# 辩论和讨论设置
# =============================================================================

# 最大辩论轮数
MAX_DEBATE_ROUNDS=1

# 最大风险讨论轮数
MAX_RISK_DISCUSS_ROUNDS=1

# 最大递归限制
MAX_RECUR_LIMIT=100

# =============================================================================
# 工具设置
# =============================================================================

# 是否启用在线工具 (true/false)
ONLINE_TOOLS=false

# 是否使用股票 API (true/false)
USE_STOCK_API=true

# =============================================================================
# 调试和性能设置
# =============================================================================

# 调试模式 (true/false)
DEBUG_MODE=false

# 代理超时时间 (秒)
AGENT_TIMEOUT=300

# 默认分析深度
DEFAULT_ANALYSIS_DEPTH=3
